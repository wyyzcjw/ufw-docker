    printf "%s请输入你的选择：%s" "$RED" "$RESET"
}

list_running_containers() {
    have docker || return 1
    mapfile -t CONTAINER_ROWS < <(docker ps --format '{{.Names}}|{{.Image}}|{{.Status}}' 2>/dev/null)
    ((${#CONTAINER_ROWS[@]} > 0))
}

choose_container() {
    local title="${1:-请选择容器}"
    if ! list_running_containers; then
        die_menu "没有检测到运行中的 Docker 容器。"
        return 1
    fi
    printf "\n%s%s%s\n" "$CYAN" "$title" "$RESET"
    local i row name image status
    for i in "${!CONTAINER_ROWS[@]}"; do
        row="${CONTAINER_ROWS[$i]}"
        IFS='|' read -r name image status <<<"$row"
        printf "  %2d. %-28s %-28s %s\n" "$((i+1))" "$name" "$image" "$status"
    done
    printf "   0. 返回\n"
    local choice
    printf "请选择： "
    read -r choice
    [[ "$choice" =~ ^[0-9]+$ ]] || return 1
    (( choice >= 1 && choice <= ${#CONTAINER_ROWS[@]} )) || return 1
    IFS='|' read -r SELECTED_CONTAINER _ <<<"${CONTAINER_ROWS[$((choice-1))]}"
}

container_ports() {
    local name="$1"
    docker inspect --format='{{range $p, $conf := .NetworkSettings.Ports}}{{with $conf}}{{$p}}{{"\n"}}{{end}}{{end}}' "$name" 2>/dev/null |
        sed '/^[[:space:]]*$/d' | sort -u
}

container_networks() {
    local name="$1"
    docker inspect --format='{{range $name, $net := .NetworkSettings.Networks}}{{$name}}{{"\n"}}{{end}}' "$name" 2>/dev/null |
        sed '/^[[:space:]]*$/d' | sort -u
}

choose_port() {
    local name="$1"
    mapfile -t PORT_ROWS < <(container_ports "$name")
    if ((${#PORT_ROWS[@]} == 0)); then
        die_menu "容器没有已发布端口。"
        return 1
    fi
    printf "\n%s请选择容器端口（注意：使用容器端口，不是宿主机端口）%s\n" "$CYAN" "$RESET"
    local i p host
    for i in "${!PORT_ROWS[@]}"; do
        p="${PORT_ROWS[$i]}"
        host="$(docker port "$name" "$p" 2>/dev/null | paste -sd ',' - || true)"
        printf "  %2d. %-12s  宿主映射：%s\n" "$((i+1))" "$p" "${host:-未知}"
    done
    printf "   a. 全部已发布端口\n"
    printf "   0. 返回\n"
    local choice
    printf "请选择： "
    read -r choice
    if [[ "$choice" == "a" || "$choice" == "A" ]]; then
        SELECTED_PORT=""
        return 0
    fi
    [[ "$choice" =~ ^[0-9]+$ ]] || return 1
    (( choice >= 1 && choice <= ${#PORT_ROWS[@]} )) || return 1
    SELECTED_PORT="${PORT_ROWS[$((choice-1))]}"
}

choose_network_optional() {
    local name="$1"
    mapfile -t NETWORK_ROWS < <(container_networks "$name")
    SELECTED_NETWORK=""
    ((${#NETWORK_ROWS[@]} > 1)) || return 0
    printf "\n%s该容器连接了多个网络，可指定其中一个：%s\n" "$CYAN" "$RESET"
    printf "   0. 全部网络\n"
    local i
    for i in "${!NETWORK_ROWS[@]}"; do
        printf "  %2d. %s\n" "$((i+1))" "${NETWORK_ROWS[$i]}"
    done
    local choice
    printf "请选择： "
    read -r choice
    [[ "$choice" =~ ^[0-9]+$ ]] || return 1
    if (( choice == 0 )); then return 0; fi
    (( choice >= 1 && choice <= ${#NETWORK_ROWS[@]} )) || return 1
    SELECTED_NETWORK="${NETWORK_ROWS[$((choice-1))]}"
}

status_overview() {
    header
    ensure_core || { pause; return; }
    printf "%s核心规则状态%s\n" "$BOLD" "$RESET"
    "$UFW_DOCKER_BIN_RESOLVED" status 2>&1 || true
    printf "\n%sUFW 详细状态%s\n" "$BOLD" "$RESET"
    ufw status verbose 2>&1 || true
    printf "\n%sDocker 网络%s\n" "$BOLD" "$RESET"
    docker network ls 2>&1 || true
    pause
}

allow_container() {
    header
    ensure_core || { pause; return; }
    choose_container "请选择要放行的容器" || return
    choose_port "$SELECTED_CONTAINER" || return
    choose_network_optional "$SELECTED_CONTAINER" || return
    local cmd=("$UFW_DOCKER_BIN_RESOLVED" allow "$SELECTED_CONTAINER")
    [[ -n "$SELECTED_PORT" ]] && cmd+=("$SELECTED_PORT")
    [[ -n "$SELECTED_NETWORK" ]] && cmd+=("$SELECTED_NETWORK")
    run_mutating "${cmd[@]}"
    pause
}

allow_source_ip() {
    header
    ensure_core || { pause; return; }
    local source
    printf "请输入允许访问的来源 IP 或 CIDR（IPv4/IPv6）： "
    read -r source
    if ! validate_source "$source"; then
        die_menu "来源地址格式不合法。"
        pause
        return
    fi
    choose_container "请选择目标容器" || return
    choose_port "$SELECTED_CONTAINER" || return
    choose_network_optional "$SELECTED_CONTAINER" || return
    local cmd=("$UFW_DOCKER_BIN_RESOLVED" allow-ip "$source" "$SELECTED_CONTAINER")
    [[ -n "$SELECTED_PORT" ]] && cmd+=("$SELECTED_PORT")
    [[ -n "$SELECTED_NETWORK" ]] && cmd+=("$SELECTED_NETWORK")
    run_mutating "${cmd[@]}"
    pause
}

show_rules_numbered() {
    ufw status numbered 2>/dev/null | grep -E '# allow ' || true
}

manage_rules() {
    while true; do
        header
        printf "%sUFW-Docker 规则管理%s\n\n" "$BOLD" "$RESET"
        show_rules_numbered
        printf "\n  1. 按编号删除一条规则\n"
        printf "  2. 按容器筛选规则\n"
        printf "  0. 返回\n"
        local choice
        printf "请选择： "
        read -r choice
        case "$choice" in
            1)
                require_root || { pause; continue; }
                local num
                printf "请输入 UFW 规则编号： "
                read -r num
                [[ "$num" =~ ^[0-9]+$ ]] || { die_menu "规则编号无效。"; pause; continue; }
                local line
                line="$(ufw status numbered 2>/dev/null | grep -E "^\[[[:space:]]*${num}\]" || true)"
                [[ "$line" == *"# allow "* ]] || { die_menu "该编号不是 ufw-docker 管理规则，已拒绝删除。"; pause; continue; }
                run_mutating ufw delete "$num"
                pause
                ;;
            2)
                ensure_core || { pause; continue; }
                choose_container "请选择容器" || continue
                "$UFW_DOCKER_BIN_RESOLVED" list "$SELECTED_CONTAINER" 2>&1 || true
                pause
                ;;
            0) return ;;
            *) ;;
        esac
    done
}

reload_rules() {
    header
    ensure_core || { pause; return; }
    printf "%s说明：%s该操作会按容器当前 IP 重新应用普通 ufw-docker 规则。\n" "$YELLOW" "$RESET"
    printf "当前核心版本对 allow-ip 来源限制规则的自动重载仍有限制；来源 IP 规则可在“查询与删除规则”中按编号管理。\n\n"
    run_mutating "$UFW_DOCKER_BIN_RESOLVED" reload
    pause
}

container_info() {
    header
    if ! choose_container "请选择要查看的容器"; then return; fi
    printf "\n%s容器：%s%s\n" "$BOLD" "$SELECTED_CONTAINER" "$RESET"
    printf "\n%s端口映射%s\n" "$CYAN" "$RESET"
    docker port "$SELECTED_CONTAINER" 2>&1 || true
    printf "\n%s网络地址%s\n" "$CYAN" "$RESET"
    docker inspect --format='{{range $name, $net := .NetworkSettings.Networks}}{{$name}}  IPv4={{$net.IPAddress}}  IPv6={{$net.GlobalIPv6Address}}{{"\n"}}{{end}}' "$SELECTED_CONTAINER" 2>&1 || true
    printf "\n%s容器状态%s\n" "$CYAN" "$RESET"
    docker inspect --format='Status={{.State.Status}}  Started={{.State.StartedAt}}' "$SELECTED_CONTAINER" 2>&1 || true
    pause
}

install_check_menu() {
    while true; do
        header
        ensure_core || { pause; return; }
        printf "  1. 检查规则（默认私有网段）\n"
        printf "  2. 检查规则（自动检测 Docker 子网）\n"
        printf "  3. 安装规则（默认私有网段）\n"
        printf "  4. 安装规则（自动检测 Docker 子网）\n"
        printf "  5. 安装规则 + 系统命令/Man page/自动重载服务\n"
        printf "  0. 返回\n"
        local choice
        printf "请选择： "
        read -r choice
        case "$choice" in
            1) "$UFW_DOCKER_BIN_RESOLVED" check 2>&1 || true; pause ;;
            2) "$UFW_DOCKER_BIN_RESOLVED" check --docker-subnets 2>&1 || true; pause ;;
            3) run_mutating "$UFW_DOCKER_BIN_RESOLVED" install; pause ;;
            4) run_mutating "$UFW_DOCKER_BIN_RESOLVED" install --docker-subnets; pause ;;
            5) run_mutating "$UFW_DOCKER_BIN_RESOLVED" install --system; pause ;;
            0) return ;;
        esac
    done
}

service_menu() {
    while true; do
        header
        printf "当前服务状态：%s\n\n" "$(service_status_text)"
        printf "  1. 安装自动重载服务\n"
        printf "  2. 强制重装自动重载服务\n"
        printf "  3. 查看 systemd 状态\n"
        printf "  4. 启动服务\n"
        printf "  5. 停止服务\n"
        printf "  6. 重启服务\n"
        printf "  0. 返回\n"
        local choice
        printf "请选择： "
        read -r choice
        case "$choice" in
            1) ensure_core && run_mutating "$UFW_DOCKER_BIN_RESOLVED" install-service; pause ;;
            2) ensure_core && run_mutating "$UFW_DOCKER_BIN_RESOLVED" install-service --force; pause ;;
            3) systemctl status ufw-docker --no-pager 2>&1 || true; pause ;;
            4) run_mutating systemctl start ufw-docker; pause ;;
            5) run_mutating systemctl stop ufw-docker; pause ;;
            6) run_mutating systemctl restart ufw-docker; pause ;;
            0) return ;;
        esac
    done
}

choose_swarm_service() {
    mapfile -t SWARM_ROWS < <(docker service ls --format '{{.Name}}|{{.Image}}|{{.Replicas}}' 2>/dev/null)
    ((${#SWARM_ROWS[@]} > 0)) || { die_menu "未检测到 Docker Swarm 服务，或当前节点不是 manager。"; return 1; }
    local i row name image repl
    for i in "${!SWARM_ROWS[@]}"; do
        row="${SWARM_ROWS[$i]}"
        IFS='|' read -r name image repl <<<"$row"
        printf "  %2d. %-28s %-28s %s\n" "$((i+1))" "$name" "$image" "$repl"
    done
    local choice
    printf "请选择服务： "
    read -r choice
    [[ "$choice" =~ ^[0-9]+$ ]] || return 1
    (( choice >= 1 && choice <= ${#SWARM_ROWS[@]} )) || return 1
    IFS='|' read -r SELECTED_SERVICE _ <<<"${SWARM_ROWS[$((choice-1))]}"
}

choose_swarm_target_port() {
    local service="$1"
    mapfile -t SERVICE_PORTS < <(docker service inspect "$service" --format '{{range .Endpoint.Spec.Ports}}{{.TargetPort}}/{{.Protocol}}|{{.PublishedPort}}{{"\n"}}{{end}}' 2>/dev/null | sed '/^[[:space:]]*$/d')
    ((${#SERVICE_PORTS[@]} > 0)) || { die_menu "该 Swarm 服务没有发布端口。"; return 1; }
    local i t pub
    for i in "${!SERVICE_PORTS[@]}"; do
        IFS='|' read -r t pub <<<"${SERVICE_PORTS[$i]}"
        printf "  %2d. %-12s published=%s\n" "$((i+1))" "$t" "$pub"
    done
    local choice
    printf "请选择目标端口： "
    read -r choice
    [[ "$choice" =~ ^[0-9]+$ ]] || return 1
    (( choice >= 1 && choice <= ${#SERVICE_PORTS[@]} )) || return 1
    IFS='|' read -r SELECTED_SERVICE_PORT _ <<<"${SERVICE_PORTS[$((choice-1))]}"
}

swarm_menu() {
    while true; do
        header
        ensure_core || { pause; return; }
        printf "  1. 列出 Swarm 服务\n"
        printf "  2. 放行 Swarm 服务端口\n"
        printf "  3. 删除 Swarm 服务全部放行\n"
        printf "  4. 删除 Swarm 服务指定端口放行\n"
        printf "  0. 返回\n"
        local choice
        printf "请选择： "
        read -r choice
        case "$choice" in
            1) docker service ls 2>&1 || true; pause ;;
            2)
                choose_swarm_service || { pause; continue; }
                choose_swarm_target_port "$SELECTED_SERVICE" || { pause; continue; }
                run_mutating "$UFW_DOCKER_BIN_RESOLVED" service allow "$SELECTED_SERVICE" "$SELECTED_SERVICE_PORT"
                pause
                ;;
            3)
                choose_swarm_service || { pause; continue; }
                run_mutating "$UFW_DOCKER_BIN_RESOLVED" service delete allow "$SELECTED_SERVICE"
                pause
                ;;
            4)
                choose_swarm_service || { pause; continue; }
                choose_swarm_target_port "$SELECTED_SERVICE" || { pause; continue; }
                run_mutating "$UFW_DOCKER_BIN_RESOLVED" service delete allow "$SELECTED_SERVICE" "$SELECTED_SERVICE_PORT"
                pause
                ;;
            0) return ;;
        esac
    done
}

subnet_menu() {
    while true; do
        header
        ensure_core || { pause; return; }
        printf "  1. 查看 Docker 网络及子网\n"
        printf "  2. Check：自动检测全部 Docker 子网\n"
        printf "  3. Install：自动检测全部 Docker 子网\n"
        printf "  4. Check：自定义允许子网\n"
        printf "  5. Install：自定义允许子网\n"
        printf "  0. 返回\n"
        local choice
        printf "请选择： "
        read -r choice
        case "$choice" in
            1)
                docker network ls 2>&1 || true
                printf "\n"
                docker network ls -q 2>/dev/null | while read -r id; do
                    docker network inspect "$id" --format '{{.Name}} {{range .IPAM.Config}}{{.Subnet}} {{end}}' 2>/dev/null
                done
                pause
                ;;
            2) "$UFW_DOCKER_BIN_RESOLVED" check --docker-subnets 2>&1 || true; pause ;;
            3) run_mutating "$UFW_DOCKER_BIN_RESOLVED" install --docker-subnets; pause ;;
            4|5)
                local input token
                printf "请输入 CIDR，多个以空格分隔： "
                read -r input
                read -r -a SUBNETS <<<"$input"
                local ok=1
                for token in "${SUBNETS[@]}"; do
                    validate_cidr_token "$token" || ok=0
                done
                (( ok == 1 && ${#SUBNETS[@]} > 0 )) || { die_menu "CIDR 格式无效。"; pause; continue; }
                if [[ "$choice" == "4" ]]; then
                    "$UFW_DOCKER_BIN_RESOLVED" check --docker-subnets "${SUBNETS[@]}" 2>&1 || true
                else
                    run_mutating "$UFW_DOCKER_BIN_RESOLVED" install --docker-subnets "${SUBNETS[@]}"
                fi
                pause
                ;;
            0) return ;;
        esac
    done
}

run_repo_script() {
    local script="$1"
    shift || true
    local p="${ASSET_DIR}/${script}"
    [[ -x "$p" ]] || { die_menu "当前目录未找到可执行的 ${script}。"; return 1; }
    run_readonly "$p" "$@"
}

diagnostic_menu() {
    while true; do
        header
        printf "  1. 查看 UFW verbose 状态\n"
        printf "  2. 查看 IPv4 DOCKER-USER 链\n"
        printf "  3. 查看 IPv6 DOCKER-USER 链\n"
        printf "  4. 递归打印 IPv4 iptables 规则\n"
        printf "  5. 递归打印 IPv6 iptables 规则\n"
        printf "  6. 开启 IPv4 packet trace（高级）\n"
        printf "  7. 移除 IPv4 packet trace\n"
        printf "  8. 开启 IPv6 packet trace（高级）\n"
        printf "  9. 移除 IPv6 packet trace\n"
        printf " 10. 查看最近 100 行 UFW 日志\n"
        printf "  0. 返回\n"
        local choice
        printf "请选择： "
        read -r choice
        case "$choice" in
            1) ufw status verbose 2>&1 || true; pause ;;
            2) iptables -n -L DOCKER-USER 2>&1 || true; pause ;;
            3) ip6tables -n -L DOCKER-USER 2>&1 || true; pause ;;
            4) require_root && run_repo_script print-iptables.sh; pause ;;
            5) require_root && run_repo_script print-ip6tables.sh; pause ;;
            6) require_root && run_mutating "${ASSET_DIR}/trace-iptables.sh" add; pause ;;
            7) require_root && run_mutating "${ASSET_DIR}/trace-iptables.sh" remove; pause ;;
            8) require_root && run_mutating "${ASSET_DIR}/trace-ip6tables.sh" add; pause ;;
            9) require_root && run_mutating "${ASSET_DIR}/trace-ip6tables.sh" remove; pause ;;
            10)
                if [[ -r /var/log/ufw.log ]]; then tail -n 100 /var/log/ufw.log; else die_menu "无法读取 /var/log/ufw.log。"; fi
                pause
                ;;
            0) return ;;
        esac
    done
}

help_page() {
    header
    cat <<EOF
本菜单是 ufw-docker 的交互前端，不重新实现核心防火墙规则。

设计原则：
  • 普通容器规则通过 ufw-docker allow/list/delete/reload 执行。
  • 来源 IP/CIDR 放行通过 ufw-docker allow-ip 执行。
  • 删除规则默认按 UFW 编号进行，并只允许删除带 “# allow ” 注释的 ufw-docker 规则。
  • 所有修改命令在执行前展示最终命令并要求确认。
  • 不使用 eval，不自动执行 ufw enable，也不会静默重启 UFW。

重要说明：
  • ufw-docker 使用“容器端口”，不是宿主机映射端口。
  • install 操作可能修改 /etc/ufw/after.rules 和 /etc/ufw/after6.rules。
  • trace 工具会向 iptables 链插入日志规则，仅用于临时诊断。
  • 当前 allow-ip 规则的系统启动自动重载仍取决于核心脚本后续完善。

快捷方式：
  UFW_DOCKER_BIN=/path/to/ufw-docker ./ufw-docker-menu

项目：
  ${REPO_URL}
EOF
    pause
}

check_updates() {
    header
    printf "%s当前菜单版本：%s%s\n" "$CYAN" "$MENU_VERSION" "$RESET"
    printf "为避免 root 权限下直接下载并覆盖脚本，当前版本只提供安全的人工检查提示。\n"
    printf "项目尚未建立稳定 Release + SHA256 发布链路，因此不会自动更新。\n\n"
    printf "建议更新流程：Release → SHA256 校验 → bash -n → 备份 → 原子替换。\n"
    pause
}

uninstall_menu() {
    header
    ensure_core || { pause; return; }
    if ! confirm_exact "UNINSTALL" "该操作会删除 ufw-docker 系统安装、相关 UFW 规则、Man page 和 systemd 服务。"; then
        printf "%s已取消卸载。%s\n" "$BLUE" "$RESET"
        pause
        return
    fi
    require_root || { pause; return; }
    "$UFW_DOCKER_BIN_RESOLVED" uninstall
    pause
}

main() {
    if ((BASH_VERSINFO[0] < 4)) || ((BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3)); then
        printf "错误：需要 Bash >= 4.3。\n" >&2
        exit 1
    fi

    while true; do
        main_menu
        local choice
        read -r choice
        case "$choice" in
            1) status_overview ;;
            2) allow_container ;;
            3) allow_source_ip ;;
            4) manage_rules ;;
            5) reload_rules ;;
            6) container_info ;;
            7) install_check_menu ;;
            8) service_menu ;;
            9) swarm_menu ;;
            10) subnet_menu ;;
            11) diagnostic_menu ;;
            12) help_page ;;
            00|0) check_updates ;;
            90) uninstall_menu ;;
            88|q|Q) clear_screen; exit 0 ;;
            *) ;;
        esac
    done
}

if [[ "${UFW_DOCKER_MENU_LIB_ONLY:-0}" != "1" ]]; then
    main "$@"
fi
