print_two_col() {
    local left="$1" right="$2"
    local width=0
    if have tput; then width="$(tput cols 2>/dev/null || printf 80)"; else width=80; fi
    if (( width >= 92 )); then
        printf "  %-42s%s\n" "$left" "$right"
    else
        printf "  %s\n" "$left"
        [[ -n "$right" ]] && printf "  %s\n" "$right"
    fi
}

main_menu() {
    header
    print_two_col "1. 状态与规则总览" "7. 安装与规则检查 ▶"
    print_two_col "2. 容器端口放行 ▶" "8. 自动重载服务管理 ▶"
    print_two_col "3. 指定来源 IP/CIDR 放行 ▶" "9. Docker Swarm 管理 ▶"
    print_two_col "4. 查询与删除规则 ▶" "10. Docker 子网配置 ▶"
    print_two_col "5. 重载与修复规则" "11. 诊断与调试工具 ▶"
    print_two_col "6. 容器 / 端口 / 网络信息" "12. 帮助与项目说明"
    hr
    print_two_col "00. 检查更新" "90. 卸载 UFW-Docker"
    print_two_col "" "88. 退出"
