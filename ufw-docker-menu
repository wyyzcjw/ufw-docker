#!/usr/bin/env bash
set -uo pipefail

MENU_VERSION="0.1.0"
REPO_URL="https://github.com/wyyzcjw/ufw-docker"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ASSET_DIR="${UFW_DOCKER_ASSET_DIR:-$SCRIPT_DIR}"
if [[ "$ASSET_DIR" == "$SCRIPT_DIR" && -d "/usr/local/lib/ufw-docker" ]]; then
    ASSET_DIR="/usr/local/lib/ufw-docker"
fi

# ---------- colors ----------
if [[ -t 1 && "${NO_COLOR:-0}" != "1" ]]; then
    RESET=$'\033[0m'
    BOLD=$'\033[1m'
    RED=$'\033[31m'
    GREEN=$'\033[32m'
    YELLOW=$'\033[33m'
    BLUE=$'\033[34m'
    MAGENTA=$'\033[35m'
    CYAN=$'\033[36m'
    WHITE=$'\033[37m'
else
    RESET="" BOLD="" RED="" GREEN="" YELLOW="" BLUE="" MAGENTA="" CYAN="" WHITE=""
fi

pause() {
    printf "\n%s" "${BLUE}按 Enter 返回菜单...${RESET}"
    read -r _
}

hr() {
    printf "%s\n" "${GREEN}────────────────────────────────────────────────────────────────────────${RESET}"
}

die_menu() {
    printf "%s错误：%s%s\n" "$RED" "$*" "$RESET" >&2
    return 1
}

have() {
    command -v "$1" >/dev/null 2>&1
}

is_root() {
    [[ "${EUID:-$(id -u)}" -eq 0 ]]
}

resolve_ufw_docker() {
    if [[ -n "${UFW_DOCKER_BIN:-}" && -x "${UFW_DOCKER_BIN}" ]]; then
        printf "%s\n" "$UFW_DOCKER_BIN"
        return 0
    fi
    if [[ -x "${SCRIPT_DIR}/ufw-docker" ]]; then
        printf "%s\n" "${SCRIPT_DIR}/ufw-docker"
        return 0
    fi
    if have ufw-docker; then
        command -v ufw-docker
        return 0
    fi
    return 1
}

UFW_DOCKER_BIN_RESOLVED=""

ensure_core() {
    if [[ -z "$UFW_DOCKER_BIN_RESOLVED" ]]; then
        UFW_DOCKER_BIN_RESOLVED="$(resolve_ufw_docker)" || {
            die_menu "未找到 ufw-docker。请先安装核心脚本，或设置 UFW_DOCKER_BIN。"
            return 1
        }
    fi
}

require_root() {
    if ! is_root; then
        die_menu "该操作需要 root 权限，请使用 sudo 运行本菜单。"
        return 1
    fi
}

validate_source() {
    local value="${1:-}"
    [[ -n "$value" ]] || return 1
    [[ "$value" =~ ^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$ ]]
}

validate_port_proto() {
    local value="${1:-}"
    [[ "$value" =~ ^[0-9]{1,5}(/(tcp|udp))?$ ]]
}

validate_cidr_token() {
    local value="${1:-}"
    [[ "$value" =~ ^[0-9A-Fa-f:.]+/[0-9]{1,3}$ ]]
}

shell_join() {
    local out="" q
    for q in "$@"; do
        printf -v q "%q" "$q"
        out+="${out:+ }${q}"
    done
    printf "%s" "$out"
}

confirm() {
    local prompt="${1:-确认执行？}"
    local answer
    printf "%s%s [y/N]: %s" "$YELLOW" "$prompt" "$RESET"
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]]
}

confirm_exact() {
    local keyword="$1"
    local prompt="$2"
    local answer
    printf "%s%s%s\n" "$RED" "$prompt" "$RESET"
    printf "请输入 %s 继续： " "$keyword"
    read -r answer
    [[ "$answer" == "$keyword" ]]
}

run_mutating() {
    require_root || return 1
    printf "\n%s将执行：%s\n  %s\n" "$YELLOW" "$RESET" "$(shell_join "$@")"
    confirm "确认执行此操作？" || {
        printf "%s已取消。%s\n" "$BLUE" "$RESET"
        return 0
    }
    "$@"
}

run_readonly() {
    "$@"
}

ufw_status_text() {
    if ! have ufw; then
        printf "未安装"
        return
    fi
    local s
    s="$(ufw status 2>/dev/null | head -n 1 || true)"
    if grep -q "Status: active" <<<"$s"; then
        printf "运行中"
    elif grep -q "Status: inactive" <<<"$s"; then
        printf "未启用"
    else
        printf "未知"
    fi
}

docker_status_text() {
    if ! have docker; then
        printf "未安装"
    elif docker info >/dev/null 2>&1; then
        printf "运行中"
    else
        printf "不可用"
    fi
}

iptables_backend() {
    if ! have iptables; then
        printf "unknown"
        return
    fi
    local v
    v="$(iptables --version 2>/dev/null || true)"
    if [[ "$v" == *"(legacy)"* ]]; then
        printf "legacy"
    elif [[ "$v" == *"(nf_tables)"* ]]; then
        printf "nf_tables"
    else
        printf "unknown"
    fi
}

service_status_text() {
    if ! have systemctl; then
        printf "不支持"
    elif systemctl is-active --quiet ufw-docker 2>/dev/null; then
        printf "运行中"
    elif systemctl list-unit-files ufw-docker.service >/dev/null 2>&1; then
        printf "已安装/未运行"
    else
        printf "未安装"
    fi
}

clear_screen() {
    if have clear; then clear; else printf "\033c"; fi
}

